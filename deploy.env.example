# Copy to .env next to docker-compose.yml, then: docker compose --env-file .env up -d --build
# Or: copy to .env (Compose loads it automatically).

POSTGRES_PASSWORD=use-a-long-random-password
POSTGRES_PORT=5432

NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=4000

REVALIDATE_SECRET=
ADMIN_REQUIRE_PASSWORD=true
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
