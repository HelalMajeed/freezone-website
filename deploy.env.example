# Copy to .env next to docker-compose.yml, then: docker compose --env-file .env up -d --build
# Or: copy to .env (Compose loads it automatically).

POSTGRES_PASSWORD=use-a-long-random-password
POSTGRES_PORT=5432

NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=4000

REVALIDATE_SECRET=
ADMIN_REQUIRE_PASSWORD=true
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Secret-link admin access (dashboard has no username/password UI).
# Enter via /dashboard/login?key=<ADMIN_DIRECT_LINK_TOKEN>. See docs/ADMIN_DIRECT_ACCESS.md.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production all three are required (fail-closed otherwise). Never commit a real token.
ADMIN_DIRECT_LOGIN=true
ADMIN_DIRECT_LINK_TOKEN=
ADMIN_DIRECT_LOGIN_PRODUCTION_ACK=true
