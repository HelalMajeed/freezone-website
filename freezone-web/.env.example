# Internal Server Error / ENOENT: أوقف كل نوافذ npm run dev، ثم على Windows: npm run dev:restart
# أو يدوياً: npm run clean && npm run dev
#
# PostgreSQL — production (Neon, Supabase, RDS) يُفضّل sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# تطوير محلي: من جذر المشروع
#   npm run env:init && npm run db:local
# db:local يشغّل docker compose إن وُجد docker؛ وإلا ينفّذ migrate + seed فقط (يلزم Postgres على DATABASE_URL)
# مع Docker على Windows: npm run db:local:win
# بدون Docker: ثبّت PostgreSQL محلياً أو ضع رابط Neon/Supabase في DATABASE_URL
# المنفذ يجب أن يطابق طريقة تشغيل Postgres لديك (ونفس القيمة في freezone-api/.env):
#   5432 = Docker من هذا المجلد: npm run db:up
#   5433 = مكوّن محلي: npm run pg:cluster:start (انظر scripts/pg-local-cluster-start.ps1)
# عند npm run dev يُشغَّل Postgres تلقائياً (Docker على 5432 أو pg-local-cluster على 5433 في Windows). لتعطيل ذلك: SKIP_DEV_DATABASE=1
# بعد تشغيل Postgres يُطبَّق prisma migrate deploy تلقائياً. تعطيل: SKIP_PRISMA_MIGRATE=1
# Vite يبدأ بعد استجابة API على المنفذ 4000. تعطيل الانتظار: SKIP_WAIT_API=1
#
# ——— فتح الموقع من جهاز آخر على نفس الشبكة (LAN) ———
# 1) من الجهاز المضيف: npm run dev (Vite مضبوط على host: true في vite.config.ts).
# 2) على الجهاز الآخر افتح: http://عنوان-IP-الجهاز-المضيف:3000 (ليس localhost — ذلك يشير لجهازك فقط).
# 3) إن لم يفتح: Windows Firewall — من freezone-web شغّل كمسؤول: npm run lan:firewall (أو .\scripts\allow-lan-dev-firewall.ps1).
#    لمعرفة عنوان الـ IP الصحيح (تجاهل 172.x من Hyper-V): npm run lan:info
# 4) اختياري لعناوين canonical في الواجهة: VITE_PUBLIC_SITE_URL="http://192.168.x.x:3000"
DATABASE_URL="postgresql://freezone:freezone_dev@localhost:5432/freezone"
# عنوان خادم Express (الباك إند) — يُستخدم في SSR وطلبات الإدارة. يجب أن يطابق منفذ freezone-api
API_INTERNAL_URL="http://127.0.0.1:4000"
# حد أقصى لانتظار طلبات SSR إلى Express (ملّي ثانية) — يقلّل التعليق عند سقوط API/DB
# INTERNAL_API_FETCH_TIMEOUT_MS="8000"
# اختياري — نفس القيمة في freezone-api/.env لمسار إبطال الكاش
REVALIDATE_SECRET=""
# بدون أي Postgres (واجهة + بيانات تجريبية من الكود فقط): ضع true وأعد التشغيل
# STATIC_STOREFRONT_ONLY="true"
# أداء إضافي (اختياري): DATABASE_URL="...freezone?connection_limit=10&pool_timeout=20"
# كاش واجهة المتجر مع API (ثوانٍ، الحد الأدنى 60) — افتراضي 300
# STOREFRONT_REVALIDATE_SECONDS="300"

# Public site URL (no trailing slash) — sitemap / JSON-LD (محلياً استخدم http://localhost:3000)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin CMS (/admin)
# افتراضياً: دخول بدون كلمة مرور. للإنتاج: ADMIN_REQUIRE_PASSWORD=true و ADMIN_PASSWORD قوية
ADMIN_REQUIRE_PASSWORD="false"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_SESSION_SECRET="generate-a-long-random-secret"
# يجب أن تطابق ADMIN_PASSWORD و ADMIN_SESSION_SECRET و ADMIN_REQUIRE_PASSWORD في freezone-api/.env
# (طلبات /api/admin/* الأخرى تمرّر إلى Express وتتحقق من نفس الكوكي)

# ——— Hosting (VPS / Docker / Vercel Node) ———
# 1) Never set STATIC_STOREFRONT_ONLY=true in production — the storefront reads Postgres via Prisma.
# 2) Set DATABASE_URL to your host (Neon/Supabase/RDS). Prefer sslmode=require in the URL.
# 3) First deploy / schema updates: npx prisma migrate deploy && npx prisma db seed (seed is safe to re-run for demo data; skip if you only want migrations)
# 4) Production build: npm run build:prod  (runs migrate deploy then next build — needs DATABASE_URL at build time)
# 5) Start: NODE_ENV=production npm start
# 6) Set NEXT_PUBLIC_SITE_URL to your real https origin (sitemap / JSON-LD).
