# Netlify redirects/rewrites — shipped inside the publish dir so the manual
# actions-netlify deploy honors them (the root netlify.toml is dead config
# under that deploy path). ORDER MATTERS: first match wins, SPA fallback LAST.

# /sitemap.xml is a static file written at build time (scripts/prerender.mjs)
# from the storefront catalogue — no proxy rule: static files are served first.

# Uploaded media lives on the API host (system of record) — force-proxy so
# site-relative /uploads/* URLs always resolve to the latest files (admin panel).
/uploads/* https://freezone-website.fly.dev/uploads/:splat 200!

# Pages of the previous storefront that the site (src/site) no longer has: their
# old addresses go to the nearest live page. /checkout, /wishlist and /contact
# are pages of the current site and are not listed here.
# Old numeric product ids are handled in netlify/edge-functions/seo-product-404.ts.
/ar/category/* /ar/products/ 301
/ar/brand/* /ar/products/ 301
/en/category/* /en/products/ 301
/en/brand/* /en/products/ 301
/ar/about /ar/ 301
/ar/pc-builder /ar/ 301
