# Netlify redirects/rewrites — shipped inside the publish dir so the manual
# actions-netlify deploy honors them (the root netlify.toml is dead config
# under that deploy path). ORDER MATTERS: forced proxies first, SPA fallback LAST.

# Sitemap is generated by the API (GET /api/public/sitemap.xml) — force-proxy it
# so https://freezone-iq.com/sitemap.xml serves real XML, not the SPA shell.
/sitemap.xml https://freezone-website.fly.dev/api/public/sitemap.xml 200!

# Uploaded media lives on the API host (system of record) — force-proxy so
# site-relative /uploads/* URLs always resolve to the latest files.
/uploads/* https://freezone-website.fly.dev/uploads/:splat 200!

# SPA fallback — must stay last. Static files and prerendered shells win first.
/* /index.html 200
