# انسخ إلى .env في هذا المجلد (freezone-api)
# يجب أن يطابق DATABASE_URL في freezone-web/.env حرفياً.
# 5432 = Docker (npm run db:up من freezone-web)  |  5433 = pg-local-cluster (npm run pg:cluster:start)
# يُضاف تلقائياً connect_timeout=5 ثانية ما لم يُعرّف في الرابط (انظر prisma.ts).
# PG_CONNECT_TIMEOUT_SECONDS=8
DATABASE_URL="postgresql://freezone:freezone_dev@localhost:5432/freezone"
# منفذ خادم Express (افتراضي 4000)
API_PORT=4000
# استماع على كل الواجهات (افتراضي 0.0.0.0) حتى يصل الطلب من أجهزة الشبكة المحلية — للتقييد على الجهاز فقط: API_HOST=127.0.0.1
# API_HOST=0.0.0.0
# عنوان Next.js لإبطال الكاش بعد تعديلات الإدارة
NEXT_INTERNAL_ORIGIN="http://127.0.0.1:3000"
# اختياري — نفس القيمة في freezone-web/.env إن أردت تأمين مسار إبطال الكاش
REVALIDATE_SECRET=""
# سجلات وصول HTTP بصيغة JSON على stdout (اختياري؛ الإيقاف الافتراضي في الإنتاج)
# LOG_HTTP=1
