# انسخ إلى .env في هذا المجلد (freezone-api) — لا ترفع .env إلى Git.
# استبدل القيم أدناه بعنوان قاعدة البيانات الحقيقي (Fly/Neon). هذا الملف للتوثيق فقط.
# يجب أن يطابق DATABASE_URL في freezone-web/.env حرفياً.
# 5432 = Docker (npm run db:up من freezone-web)  |  5433 = pg-local-cluster (npm run pg:cluster:start)
# يُضاف تلقائياً connect_timeout=5 ثانية ما لم يُعرّف في الرابط (انظر prisma.ts).
# PG_CONNECT_TIMEOUT_SECONDS=8
DATABASE_URL="postgresql://freezone:freezone_dev@localhost:5432/freezone"
#
# Fly.io: set secret DATABASE_URL on the app to the Postgres that holds your real catalog (same Neon/Supabase URL you used locally, or Fly Postgres after importing a backup). A fresh Fly Postgres DB will show 0 products until data is migrated.
# Read-only counts: npm run db:counts --prefix freezone-api (uses this DATABASE_URL)
#
# ——— Admin login (freezone-api) ———
# Default: direct login (no password). For production, require a password:
#   ADMIN_REQUIRE_PASSWORD=true
#   ADMIN_PASSWORD=<strong secret>
#   ADMIN_SESSION_SECRET=<long random string; used to sign the admin cookie>
#
# Testing only (Fly): bypass session checks for all /api/admin/* — NEVER leave on in production:
#   ADMIN_SKIP_AUTH=true
#
# When the admin UI is on a different host than the API (e.g. Netlify + Fly), cookies need SameSite=None:
#   ADMIN_SESSION_SAMESITE=none
#
# ——— Legacy admin cookie (transition flag) ———
# The old HMAC cookie (fz_admin_session) is no longer accepted by the /api/admin/*
# route guards by default. Auth now uses the dashboard session (fz_dashboard_session,
# DB-backed, revocable, real per-user audit attribution) via /dashboard/login.
# During the transition you can temporarily re-enable the legacy cookie:
#   LEGACY_ADMIN_COOKIE=true
# Default: off. Remove once every operator has a dashboard account.
# LEGACY_ADMIN_COOKIE="false"
#
# Generate all three locally or for Fly:
#   npm run admin:auth-print --prefix freezone-api
#   npm run admin:auth-fly --prefix freezone-api   # needs flyctl + fly auth (sets secrets on freezone-website)
# Mirror ADMIN_REQUIRE_PASSWORD, ADMIN_PASSWORD, ADMIN_SESSION_SECRET in freezone-web/.env when using npm run dev.
# ADMIN_REQUIRE_PASSWORD="false"
# ADMIN_PASSWORD="change-this-strong-password"
# ADMIN_SESSION_SECRET="generate-a-long-random-secret"
#
# ─── Local-only frictionless dashboard login ──────────────────────────────────
# Enable the "Skip login (dev)" button on /dashboard/login during local dev so
# you don't need to remember a password while iterating. Activates POST
# /api/dashboard/auth/dev-login which upserts a SUPER_ADMIN dev@local user and
# returns a session cookie.
#
# Returns 404 unless BOTH conditions hold at runtime:
#   1. NODE_ENV !== "production"   (Fly's Dockerfile bakes NODE_ENV=production,
#                                   so this env has no effect there)
#   2. DASHBOARD_DEV_BYPASS=true
# Never set this on Fly. Local only.
# DASHBOARD_DEV_BYPASS="true"
#
# منفذ خادم Express (افتراضي 4000)
API_PORT=4000
# استماع على كل الواجهات (افتراضي 0.0.0.0) حتى يصل الطلب من أجهزة الشبكة المحلية — للتقييد على الجهاز فقط: API_HOST=127.0.0.1
# API_HOST=0.0.0.0
# عنوان Next.js لإبطال الكاش بعد تعديلات الإدارة
NEXT_INTERNAL_ORIGIN="http://127.0.0.1:3000"
# اختياري — نفس القيمة في freezone-web/.env إن أردت تأمين مسار إبطال الكاش
REVALIDATE_SECRET=""
# سجلات وصول HTTP بصيغة JSON على stdout (اختياري؛ الإيقاف الافتراضي في الإنتاج)
# LOG_HTTP=1
#
# ——— Sentry (Phase 0/1) ———
# SENTRY_DSN is the canonical var read by the observability shim (captureError/
# captureMessage). SENTRY_DSN_API is accepted as a fallback alias only.
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_DSN_API=""   # optional alias for SENTRY_DSN
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"
#
# ——— Production-important runtime config ———
# CORS allow-list (comma-separated). Exact origins or a regex (anchored with ^ or
# containing \.) are supported. When UNSET it falls back to the built-in prod
# origins (freezone-iq.com, *.netlify.app, the Fly app, localhost). Set this on
# Fly to lock the allow-list down to your real frontends.
# CORS_ORIGINS="https://freezone-iq.com,https://your-site.netlify.app"
#
# USD→IQD exchange rate used for SUGGESTED USD pricing across the catalog. WRONG
# value skews every suggested USD price. Defaults to 1450 IQD per 1 USD when unset.
# CATALOG_USD_IQD_RATE="1450"
#
# Canonical site origin used to build absolute URLs in sitemap.xml. Default: https://freezone-iq.com
# PUBLIC_SITE_ORIGIN="https://freezone-iq.com"
#
# Origin that serves /uploads images in catalog responses. Default: https://freezone-website.fly.dev
# PUBLIC_UPLOADS_ORIGIN="https://freezone-website.fly.dev"
#
# SameSite for the dashboard session cookie (fz_dashboard_session) + admin logout.
# Use "none" when the dashboard UI is on a different host than the API. Default: lax.
# DASHBOARD_COOKIE_SAMESITE="lax"
#
# ── Secret-link admin access (POST /api/dashboard/auth/direct-login) ──────────
# The dashboard has NO username/password UI. The only way in is a private link
# carrying a secret token:  /dashboard/login?key=<ADMIN_DIRECT_LINK_TOKEN>
# Opening /dashboard or /dashboard/login without the key never creates a session.
#
#   ADMIN_DIRECT_LOGIN=true                  feature switch
#   ADMIN_DIRECT_LINK_TOKEN=<secret>         the secret carried by the link
#   ADMIN_DIRECT_LINK_TOKEN_HASH=<sha256>    optional: store only the hash instead
#   ADMIN_DIRECT_LOGIN_PRODUCTION_ACK=true   REQUIRED in production (explicit ack)
#
# Generate a token:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Fail-closed: if enabled but no token (or, in production, no ACK) the endpoint
# returns 403 and issues nothing. Rotate access by changing the token.
# Never commit a real token. A secret-in-URL protects a single owner; prefer
# Cloudflare Access / IP allowlist in front of /dashboard for stronger hardening.
# ADMIN_DIRECT_LOGIN="false"
# ADMIN_DIRECT_LINK_TOKEN=""
# ADMIN_DIRECT_LINK_TOKEN_HASH=""
# ADMIN_DIRECT_LOGIN_PRODUCTION_ACK="false"
