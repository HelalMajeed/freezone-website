{
  "name": "freezone-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/server.ts \"src/app/api/**/route.ts\" --bundle --splitting --platform=node --target=node22 --format=esm --outdir=dist --outbase=src --packages=external --alias:@=./src",
    "routes:check": "node scripts/check-route-parity.mjs",
    "test": "tsx --test src/lib/import-globaliraq/resolve-category.test.ts src/lib/import-globaliraq/category-attributes.test.ts src/lib/import-globaliraq/warranty.test.ts src/lib/import-globaliraq/map-product.test.ts src/lib/rate-limit.test.ts src/lib/coupon-service.test.ts src/lib/catalog.test.ts src/lib/catalog-filter.test.ts src/lib/bootstrap-trim.test.ts src/lib/admin-direct-login.test.ts src/lib/admin-orders-query.test.ts src/lib/iraq-provinces.test.ts src/lib/phone.test.ts src/lib/customer-auth.test.ts src/lib/rate-rules.test.ts src/lib/payments/registry.test.ts src/lib/shipping-fees.test.ts src/lib/review-stats.test.ts src/lib/admin-session.test.ts src/lib/csrf-origin.test.ts",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo-products.ts",
    "classification:seed": "npx tsx scripts/seed-classification-only.ts",
    "classification:sync-legacy": "npx tsx scripts/sync-legacy-product-specs.ts",
    "classification:repair-laptop-filters": "npx tsx scripts/repair-laptop-filter-values.ts",
    "classification:repair": "npm run classification:seed && npm run classification:sync-legacy",
    "db:seed:classification": "npm run classification:seed",
    "db:sync:legacy-specs": "npm run classification:sync-legacy",
    "db:sync:classification": "npm run classification:repair",
    "db:delete-products": "tsx prisma/delete-all-products.ts",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:status": "prisma migrate status",
    "db:counts": "node scripts/print-db-counts.mjs",
    "db:survey": "node scripts/survey-db-extended.mjs",
    "db:survey-all-envs": "node scripts/survey-batch-env-candidates.mjs",
    "db:survey-sequential": "node scripts/survey-db-sequential-tables.mjs",
    "import:globaliraq": "tsx scripts/import-globaliraq-products.ts",
    "import:globaliraq:test": "tsx scripts/import-globaliraq-products.ts --limit 5",
    "import:globaliraq:dry": "tsx scripts/import-globaliraq-products.ts --limit 5 --dry-run",
    "import:globaliraq:verify": "node scripts/import-globaliraq/verify.mjs",
    "import:globaliraq:repair": "tsx scripts/repair-globaliraq-import.ts",
    "delete:globaliraq:dry": "tsx scripts/delete-globaliraq-imported-products.ts --dry-run",
    "delete:globaliraq": "tsx scripts/delete-globaliraq-imported-products.ts --confirm",
    "fly:deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/fly-deploy.ps1",
    "admin:auth-print": "node scripts/configure-admin-auth.mjs",
    "admin:auth-fly": "node scripts/configure-admin-auth.mjs --apply-fly",
    "db:seed:dashboard": "tsx prisma/seed-dashboard-superadmin.ts",
    "import:globaliraq:discover": "node scripts/import-globaliraq/discover.mjs",
    "import:globaliraq:scrape": "node scripts/import-globaliraq/scrape-product.mjs",
    "import:globaliraq:sample": "node scripts/import-globaliraq/import-sample.mjs",
    "import:globaliraq:dry-delete": "node scripts/import-globaliraq/dry-run-delete.mjs",
    "catalog:import": "tsx scripts/catalog/import.ts",
    "catalog:audit": "tsx scripts/catalog/audit.ts",
    "catalog:images:audit": "tsx scripts/catalog/audit.ts --only=images",
    "catalog:filters:audit": "tsx scripts/catalog/audit.ts --only=filters",
    "catalog:pricing:audit": "tsx scripts/catalog/audit.ts --only=pricing",
    "catalog:demo": "tsx scripts/catalog/import.ts --source data/import/samples/example-products.json --dry-run && tsx scripts/catalog/audit.ts --source data/import/samples/example-products.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^9.15.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^3.14.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.3.1",
    "sharp": "^0.34.5",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
